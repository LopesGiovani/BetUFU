{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BETUFU read-only reviewer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reviewer",
    "plan_id",
    "base",
    "head",
    "changed_files",
    "gates",
    "findings",
    "summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "ERROR"]
    },
    "reviewer": {
      "type": "string",
      "enum": ["security", "ui", "verification"]
    },
    "plan_id": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}$"
    },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "changed_files": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "file_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9A-F]{64}$"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["PASS", "BLOCKED", "ERROR"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "detail"],
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "INFO"] },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
