{
  "version": 2,
  "purpose": "Deterministic routing manifest for BETUFU agents. It selects focused guidance; it does not grant authorization or install skills.",
  "selection": {
    "mode": "deterministic",
    "always_worker_skills": ["betufu-wave-guardrails"],
    "fallback_bundle": "planning",
    "worker_content": "Only versioned .agents/skills/*/SKILL.md files are injected into the worker prompt.",
    "external_skills": "control-plane-only"
  },
  "bundles": {
    "planning": {
      "when": "Exploring the codebase, preparing a plan, or assessing refactor impact.",
      "skills": [
        "betufu-wave-guardrails",
        "codebase-exploration",
        "architectural-decisions",
        "pre-modification-check"
      ],
      "worker_skills": ["betufu-wave-guardrails"],
      "control_skills": ["codebase-exploration", "architectural-decisions", "pre-modification-check"],
      "reviewers": ["verification"],
      "gates": ["scope", "structured-result", "evidence"],
      "repowise": ["get_impact", "get_deps", "find_references"]
    },
    "backend-api": {
      "when": "Changing Spring Boot, Java, persistence, authorization, migrations, or HTTP APIs.",
      "skills": [
        "betufu-wave-guardrails",
        "architectural-decisions",
        "pre-modification-check",
        "code-health",
        "change-review"
      ],
      "worker_skills": ["betufu-wave-guardrails"],
      "control_skills": ["architectural-decisions", "pre-modification-check", "code-health", "change-review"],
      "reviewers": ["verification", "security"],
      "gates": ["scope", "structured-result", "discriminating-tests", "aggregate-backend", "aggregate-node"],
      "repowise": ["find_symbol", "lsp_definition", "lsp_hover", "get_impact"]
    },
    "frontend-angular": {
      "when": "Changing Angular components, Signals, stores, adapters, routes, or templates.",
      "skills": [
        "betufu-wave-guardrails",
        "angular-signals-patterns",
        "frontend-accessibility-wcag",
        "pre-modification-check"
      ],
      "worker_skills": ["betufu-wave-guardrails", "angular-signals-patterns", "frontend-accessibility-wcag"],
      "control_skills": ["pre-modification-check"],
      "reviewers": ["verification", "ui"],
      "gates": ["scope", "structured-result", "discriminating-tests", "aggregate-backend", "aggregate-node", "aggregate-angular"],
      "repowise": ["find_symbol", "lsp_definition", "find_references", "get_impact"]
    },
    "ui-e2e": {
      "when": "Changing visible behavior, responsive layout, accessibility, or browser flows.",
      "skills": [
        "betufu-wave-guardrails",
        "frontend-accessibility-wcag",
        "playwright-cli",
        "change-review"
      ],
      "worker_skills": ["betufu-wave-guardrails", "frontend-accessibility-wcag", "playwright-cli"],
      "control_skills": ["change-review"],
      "reviewers": ["ui", "verification"],
      "gates": ["scope", "structured-result", "aggregate-backend", "aggregate-node", "aggregate-angular", "aggregate-playwright"],
      "repowise": ["find_callers", "find_references", "get_impact"]
    },
    "security": {
      "when": "Reviewing authentication, authorization, privacy, injection, XSS, SSRF, running Strix pentests, fixing findings, or gating CI.",
      "skills": [
        "betufu-wave-guardrails",
        "architectural-decisions",
        "gsd-secure-phase",
        "penetration-testing-with-strix",
        "fix-security-vulnerabilities-with-strix",
        "ci-security-scanning-with-strix",
        "managed-pentesting-with-strix",
        "change-review"
      ],
      "worker_skills": ["betufu-wave-guardrails"],
      "control_skills": [
        "architectural-decisions",
        "gsd-secure-phase",
        "penetration-testing-with-strix",
        "fix-security-vulnerabilities-with-strix",
        "change-review"
      ],
      "reviewers": ["security", "verification"],
      "gates": ["scope", "structured-result", "security-review", "discriminating-tests"],
      "repowise": ["get_impact", "find_callers", "find_references"]
    },
    "verification-review": {
      "when": "Verifying a completed plan, auditing tests, reviewing a snapshot, or checking phase integration.",
      "skills": [
        "betufu-wave-guardrails",
        "gsd-nyquist-auditor",
        "gsd-integration-checker",
        "gsd-code-review",
        "change-review",
        "code-health"
      ],
      "worker_skills": ["betufu-wave-guardrails"],
      "control_skills": ["gsd-nyquist-auditor", "gsd-integration-checker", "gsd-code-review", "change-review", "code-health"],
      "reviewers": ["verification", "security", "ui"],
      "gates": ["scope", "structured-result", "aggregate-backend", "aggregate-node"],
      "repowise": ["find_tests_for_symbol", "find_references", "get_impact", "find_callers"]
    }
  },
  "routing": [
    {
      "bundle": "security",
      "priority": 400,
      "path_prefixes": ["backend/src/main/java/br/com/betufu/identity/", "backend/src/main/java/br/com/betufu/platform/session/", "backend/src/main/java/br/com/betufu/platform/security/", "frontend/src/app/core/auth/", "frontend/src/app/features/sports/athlete-profile/", "frontend/src/app/features/sports/public-athlete/"],
      "keywords": ["security", "authorization", "authentication", "permission", "owner-only", "xss", "ssrf", "csrf", "sanitiz", "privacy", "token", "password", "keycloak", "hmac"]
    },
    {
      "bundle": "ui-e2e",
      "priority": 300,
      "path_prefixes": ["frontend/e2e/", "frontend/playwright/"],
      "keywords": ["playwright", "browser", "responsive", "accessibility", "wcag", "template", "visual", "e2e"]
    },
    {
      "bundle": "frontend-angular",
      "priority": 200,
      "path_prefixes": ["frontend/src/app/", "frontend/src/environments/"],
      "keywords": ["angular", "signal", "store", "component", "route", "template", "rxjs"]
    },
    {
      "bundle": "backend-api",
      "priority": 100,
      "path_prefixes": ["backend/", "scripts/maven.mjs"],
      "keywords": ["spring", "java", "backend", "controller", "repository", "migration", "flyway", "openapi", "dto", "persistence"]
    },
    {
      "bundle": "verification-review",
      "priority": 50,
      "path_prefixes": [".agents/"],
      "keywords": ["verification", "snapshot", "integration", "integracao", "audit", "auditoria"]
    }
  ],
  "reviewer_profiles": {
    "security": {
      "mode": "plan",
      "readonly": true,
      "skills": ["gsd-secure-phase", "change-review"],
      "focus": ["authorization", "data exposure", "injection", "XSS", "SSRF", "secrets"],
      "required_gates": ["scope", "worktree-clean", "diff-check", "security-review"]
    },
    "ui": {
      "mode": "plan",
      "readonly": true,
      "skills": ["frontend-accessibility-wcag", "change-review"],
      "focus": ["responsive behavior", "keyboard access", "semantics", "visual regressions"],
      "required_gates": ["scope", "worktree-clean", "diff-check", "ui-review"]
    },
    "verification": {
      "mode": "plan",
      "readonly": true,
      "skills": ["gsd-nyquist-auditor", "gsd-integration-checker", "change-review"],
      "focus": ["allowlist", "test evidence", "generated artifacts", "integration boundaries"],
      "required_gates": ["scope", "worktree-clean", "diff-check", "structured-result", "test-evidence"]
    }
  },
  "repowise_policy": {
    "tool_prefix": "mcp__RepoWise_MCP_for_BetUFU__",
    "preferred_order": "Use RepoWise MCP/LSP before native search whenever the tools are available.",
    "batching": "Call independent structural lookups together; chain only when one result is the next query input.",
    "fallback": "If RepoWise is unavailable, use read-only native inspection, record the limitation, and never claim a RepoWise lookup occurred."
  }
}
