# ATENÇÃO: valores públicos e descartáveis, exclusivos do ambiente local em loopback.
# Proibido reutilizar em homologação, produção, CI compartilhado, máquina multiusuário não confiável, túnel/port-forward ou daemon Docker remoto.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=betufu-local-postgres-admin
POSTGRES_DB=postgres

BETUFU_DB_NAME=betufu_local
BETUFU_DB_USER=betufu_app
BETUFU_DB_PASSWORD=betufu-local-postgres-app

KEYCLOAK_DB_NAME=keycloak_local
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=betufu-local-keycloak-db

BETUFU_REDIS_PASSWORD=betufu-local-redis

KC_BOOTSTRAP_ADMIN_USERNAME=betufu-local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=betufu-local-keycloak-admin
BETUFU_OIDC_CLIENT_ID=betufu-bff
BETUFU_OIDC_CLIENT_SECRET=betufu-local-bff-client-secret
BETUFU_OIDC_ISSUER_URI=http://localhost:8081/realms/betufu-local
BETUFU_TECHNICAL_USERNAME=technical
BETUFU_TECHNICAL_PASSWORD=betufu-local-technical
BETUFU_TECHNICAL_EMAIL=technical@betufu.local

BETUFU_S3_ENDPOINT=http://127.0.0.1:8333
BETUFU_S3_BUCKET=betufu-local
BETUFU_S3_REGION=us-east-1
BETUFU_S3_ACCESS_KEY_ID=betufu-local-s3-access
BETUFU_S3_SECRET_ACCESS_KEY=betufu-local-s3-secret
BETUFU_S3_FORCE_PATH_STYLE=true
