<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="02-24-01-create-password-reset-outbox-table" author="betufu">
        <createTable tableName="betufu_password_reset_outbox">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="pk_betufu_password_reset_outbox" nullable="false"/>
            </column>
            <column name="source_event_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_betufu_password_reset_outbox_source_event"/>
            </column>
            <column name="subject" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="realm_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="attempt_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="claimed_at" type="TIMESTAMP"/>
            <column name="claim_instance_id" type="VARCHAR(255)"/>
            <column name="delivered_at" type="TIMESTAMP"/>
            <column name="last_error" type="VARCHAR(1024)"/>
        </createTable>
    </changeSet>

    <!-- O changeset 02-24-01 ja foi aplicado e nao pode ser editado: alterar changeset aplicado
         invalida o checksum do Liquibase. A coluna ausente entra por changeset proprio. -->
    <changeSet id="02-28-01-add-next-attempt-at" author="betufu">
        <addColumn tableName="betufu_password_reset_outbox">
            <column name="next_attempt_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
