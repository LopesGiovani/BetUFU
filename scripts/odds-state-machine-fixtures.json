      "methods": [
        {
          "name": "getEventForOdds",
          "parameters": [
            "UUID eventId"
          ],
          "returns": "Optional<SportsEventForOdds>",
          "description": "Consulta projecao minima de elegibilidade do evento pre-game."
        },
        {
          "name": "getConfirmedResultForOdds",
          "parameters": [
            "UUID eventId",
            "UUID confirmedVersionId"
          ],
          "returns": "Optional<ConfirmedSportsResultForOdds>",
          "description": "Consulta versao exata confirmada de resultado para observacao historica ou liquidacao."
        },
        {
          "name": "findAdmissibleResultsAsOf",
          "parameters": [
            "UUID competitionId",
            "UUID editionId",
            "Instant asOfCutoff"
          ],
          "returns": "List<ConfirmedSportsResultForOdds>",
          "description": "Consulta cronologica de resultados confirmados conhecidos ate o corte temporal."
        }
      ]
    },
