    "definitions": {
      "SPORTING_RESULT": {
        "meaning": "Resultado esportivo valido confirmado/corrigido na cadeia V16.",
        "feedsElo": true,
        "feedsDavidson": true,
        "hasScore": true,
        "drawEligibility": "Apenas quando regulamento da modalidade/fase autorizar empate no tempo regulamentar.",
        "marketOutcome": "VALID_SPORTING_OUTCOME",
        "settlementEffect": "NORMAL_SETTLEMENT"
      },
      "ADMINISTRATIVE_WALKOVER": {
        "meaning": "Vitoria por W.O. administrativo sem placar esportivo.",
        "feedsElo": false,
        "feedsDavidson": false,
        "hasScore": false,
        "winnerAllowed": true,
        "winnerPolicy": "Vencedor administrativo opcional, sem efeito no rating Elo/Davidson.",
        "marketOutcome": "ADMINISTRATIVE_WALKOVER",
        "settlementEffect": "VOID_REFUND"
      },
      "ABANDONED_NO_VALID_RESULT": {
        "meaning": "Partida abandonada/interrompida sem resultado esportivo valido.",
        "feedsElo": false,
        "feedsDavidson": false,
        "hasScore": false,
        "winnerAllowed": false,
        "marketOutcome": "ABANDONED",
        "settlementEffect": "VOID_REFUND"
      },
      "CANCELLED": {
        "meaning": "Evento cancelado no lifecycle esportivo (V24 CANCELADO).",
        "feedsElo": false,
        "feedsDavidson": false,
        "hasScore": false,
        "winnerAllowed": false,
        "marketOutcome": "CANCELLED",
        "settlementEffect": "VOID_REFUND"
      },
      "POSTPONED": {
        "meaning": "Evento adiado no lifecycle esportivo (V24 ADIADO).",
        "feedsElo": false,
        "feedsDavidson": false,
        "hasScore": false,
        "winnerAllowed": false,
        "marketOutcome": "POSTPONED",
        "settlementEffect": "SUSPEND_AND_VERSION_ON_RESCHEDULE"
      }
    },
    "resultVersionStatuses": {
      "admissibleAtReplay": [
        "CONFIRMADO",
        "CORRIGIDO"
      ],
      "notAdmissibleAtReplay": [
        "INFORMADO",
        "AGUARDANDO_REVISAO"
      ]
    },
    "separationRules": [
      "CANCELLED e POSTPONED sao classes de lifecycle V24 e nao devem carregar payload de placar.",
      "ADMINISTRATIVE_WALKOVER e ABANDONED_NO_VALID_RESULT nao carregam placar esportivo nem sintetico.",
      "Empate e uma politica regulamentar restrita exclusivamente a SPORTING_RESULT.",
      "Vencedor administrativo no W.O. nao produz alteracao no rating Elo ou Davidson."
    ]
  },
  "marketStateMachine": {
    "states": [
      "DRAFT",
      "OPEN",
      "SUSPENDED",
      "CLOSED",
      "LOCKED",
      "CANCELLED"
    ],
    "stateDescriptions": {
      "DRAFT": "Rascunho de mercado em configuracao antes de publicacao de odds.",
      "OPEN": "Mercado aberto para consulta publica pre-jogo e aceitacao de palpites.",
      "SUSPENDED": "Mercado temporariamente suspenso para operacao (adiamento, distorcao ou proposta de override).",
      "CLOSED": "Apostas encerradas no close deadline (inicio canonico do evento).",
      "LOCKED": "Encerramento definitivo bloqueado para aguardar apuracao e liquidacao.",
      "CANCELLED": "Mercado anulado/cancelado com devolucao de creditos."
    },
    "initialState": "DRAFT",
    "terminalStates": [
      "LOCKED",
      "CANCELLED"
    ],
    "transitions": [
      {
        "from": "DRAFT",
        "to": "OPEN",
        "action": "PUBLISH_MARKET",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Publicacao inicial do mercado com preco e elenco publicado."
      },
      {
        "from": "DRAFT",
        "to": "CANCELLED",
        "action": "CANCEL_DRAFT",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Cancelamento de mercado em rascunho."
      },
      {
        "from": "OPEN",
        "to": "SUSPENDED",
        "action": "SUSPEND_MARKET",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Suspensao por adiamento (D-111), deteccao de anomalia ou proposta de override (D-116)."
      },
      {
        "from": "OPEN",
        "to": "CLOSED",
        "action": "CLOSE_DEADLINE",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Fechamento automatico ao atingir o scheduledAt do evento."
      },
      {
        "from": "OPEN",
        "to": "CANCELLED",
        "action": "CANCEL_MARKET",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Cancelamento do mercado por cancelamento do evento (D-110)."
      },
      {
        "from": "SUSPENDED",
        "to": "OPEN",
        "action": "RESUME_MARKET",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Reabertura apos resolucao de suspensao ou rejeicao de override."
      },
      {
        "from": "SUSPENDED",
        "to": "CLOSED",
        "action": "CLOSE_SUSPENDED",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Chegada do deadline de inicio durante suspensao."
      },
      {
        "from": "SUSPENDED",
        "to": "CANCELLED",
        "action": "CANCEL_SUSPENDED",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Cancelamento definitivo de evento suspenso."
      },
      {
        "from": "CLOSED",
        "to": "LOCKED",
        "action": "LOCK_MARKET",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Bloqueio definitivo pos-partida antes do settlement."
      },
      {
        "from": "CLOSED",
        "to": "SUSPENDED",
        "action": "REOPEN_SUSPENDED",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Suspensao emergencial se partida foi atrasada/nao ocorreu."
      },
      {
        "from": "CLOSED",
        "to": "CANCELLED",
        "action": "CANCEL_CLOSED",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Cancelamento pos-fechamento se jogo nao ocorreu."
      },
      {
        "from": "LOCKED",
        "to": "CANCELLED",
        "action": "VOID_LOCKED",
        "requiredCapability": "MANAGE_ODDS_MARKET",
        "description": "Anulacao administrativa extraordinaria antes da liquidacao."
      }
    ],
    "forbiddenTransitions": [
      {
        "from": "CLOSED",
        "to": "OPEN",
        "reason": "Mercado fechado nao pode ser reaberto diretamente sem suspensao auditada."
      },
      {
        "from": "LOCKED",
        "to": "OPEN",
        "reason": "Mercado locked e terminal e imutavel."
      },
      {
        "from": "LOCKED",
        "to": "DRAFT",
        "reason": "Regressao para rascunho e proibida."
      },
      {
        "from": "CANCELLED",
        "to": "OPEN",
        "reason": "Mercado cancelado e terminal."
      },
      {
        "from": "CANCELLED",
        "to": "LOCKED",
        "reason": "Mercado cancelado nao pode ser liquidado."
      },
      {
        "from": "DRAFT",
        "to": "LOCKED",
        "reason": "Salto nao autorizado sem publicacao/fechamento."
      }
    ],
    "postponementPolicy": {
      "d111Compliance": true,
      "onPostpone": "SUSPENDED",
      "onReschedule": "Creates new immutable MarketVersion and CalculationVersion with incremented versionNo and audit trace.",
      "preservesPriorVersion": true
    },
    "overridePolicy": {
      "d116Compliance": true,
      "d117Compliance": true,
      "allowedStates": [
        "SUSPENDED"
      ],
      "forbiddenStates": [
        "DRAFT",
        "OPEN",
        "CLOSED",
        "LOCKED",
        "CANCELLED"
      ],
      "distinctActorsRequired": true,
      "odds10ProofRequired": true,
      "createsNewPriceVersion": true,
      "neverRewritesAcceptedOdds": true
    }
  },
