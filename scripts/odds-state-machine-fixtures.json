{
  "schemaVersion": "04-02.odds-contract-fixtures.v1",
  "phase": "04-mercados-pr-jogo-e-odds-transparentes",
  "plan": "04-02",
  "kind": "odds_contract_and_state_machine_candidate",
  "runtimeConsumable": false,
  "purpose": "Candidato documental para contrato publico sports -> odds, taxonomia e maquina de estados antes de implementacao Java ou schema.",
  "decisionStatus": "approved_human_checkpoint_04-02-T2",
  "decisionBasis": {
    "optionsCompared": {
      "A": {
        "key": "approved_synchronous_read_port",
        "name": "Porta sincrona de leitura em sports",
        "description": "Contrato publico em sports (br.com.betufu.sports.SportsResultForOddsPort), produtor em sports.internal e consumidor em odds (br.com.betufu.odds) sem imports internos.",
        "disposition": "APPROVED_FOR_IMPLEMENTATION",
        "rationale": "Preserva fronteira modular Modulith sem introduzir fila/mensageria desnecessaria para o MVP; dependencias unidirecionais sports <- odds sao proibidas e odds -> sports consome somente contrato publico."
      },
      "B": {
        "key": "opaque_after_commit_application_event",
        "name": "Evento de aplicacao assincrono apos commit",
        "description": "Publicacao de ApplicationEvent no Spring apos commit de resultado esportivo.",
        "disposition": "REJECTED_FOR_MVP",
        "rationale": "Adiciona complexidade assincrona e risco de reentrega fora de ordem desnecessarios para o MVP monolito modular."
      },
      "C": {
        "key": "versioned_odds_projection",
        "name": "Projecao dedicada em odds mantida por eventos",
        "description": "Modulo odds mantem copia e projecao propria de resultados esportivos.",
        "disposition": "REJECTED_FOR_MVP",
        "rationale": "Viola principio de fonte unica de autoridade esportiva e duplica cadastro de placares."
      }
    },
    "selectedOption": "A",
    "selectedOptionKey": "approved_synchronous_read_port",
    "selectedOptionDescription": "Contrato pertencente a sports, produtor em sports.internal e consumidor odds sem imports internos.",
    "modularBoundary": {
      "publicPortClass": "br.com.betufu.sports.SportsResultForOddsPort",
      "publicModels": [
        "br.com.betufu.sports.SportsEventForOdds",
        "br.com.betufu.sports.ConfirmedSportsResultForOdds",
        "br.com.betufu.sports.SportsResultKindForOdds"
      ],
      "oddsPackage": "br.com.betufu.odds",
      "sportsInternalPackage": "br.com.betufu.sports.internal",
      "forbiddenImports": [
        "br.com.betufu.sports.internal.."
      ],
      "forbiddenReverseDependency": "sports cannot depend on odds"
    }
  },
  "boundaryContract": {
    "port": {
      "name": "SportsResultForOddsPort",
