  "binding": {
    "ownerModule": "sports",
    "consumerModule": "odds",
    "eventFormat": "HEAD_TO_HEAD",
    "participants": [1, 2],
    "referenceFields": ["publicationId", "versionNo"],
    "knownAtRequired": true,
    "statusRequired": "PUBLICADO",
    "snapshotImmutable": true,
    "latestImplicitSelection": false,
    "lineupPerMatch": false,
    "piiInOddsContract": false
  },
  "freeze": {
    "operation": "market_open",
    "capturesPerParticipant": true,
    "capturedValuesAreImmutable": true,
    "correctionCreatesNewPublication": true,
    "existingMarketIsNotRewritten": true,
    "oldSnapshotRemainsReadable": true
  },
  "atomicity": {
    "lockOrder": ["sports_event", "sports_roster"],
    "requiresRowLock": true,
    "compareAndSet": true,
    "noCheckThenAct": true,
    "failureMode": "fail_closed",
    "transaction": "lock, validate publication/version/scope, insert binding, commit together",
    "rollbackOnConflict": true
  },
  "scope": {
    "eventScopeComposite": ["competitionId", "editionId", "eventId"],
    "publicationScope": ["teamId", "competitionId", "editionId"],
    "crossTeamBindingForbidden": true,
    "draftPublicationForbidden": true,
    "stalePublicationForbidden": true
  },
  "correction": {
    "mechanism": "new publication supersedes prior publication",
    "marketEffect": "existing frozen market keeps old references; future opening uses new publication",
    "recalculation": "future plan owns suspension/recalculation policy",
    "historyRewrite": false
  },
  "publicBoundary": {
    "port": "SportsRosterForOddsPort",
    "adapterPackage": "br.com.betufu.sports.internal.roster",
    "oddsImportsSportsInternal": false,
    "exposedFields": ["eventId", "teamId", "publicationId", "versionNo", "knownAt"],
    "forbiddenFields": ["athleteName", "athleteSlug", "enrollmentId", "email", "pii"]
  },
  "migration": {
    "filename": "V28__bind_event_roster_publication.sql",
    "forwardOnly": true,
    "mayEditAppliedMigrations": false,
    "tables": ["odds_market_roster_binding"],
    "uniqueKeys": ["marketVersionId, slotNo", "marketVersionId, teamId"],
    "immutableBinding": true
  }
